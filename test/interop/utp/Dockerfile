# BEP29 uTP interop engine image (ntx).
#
# Reference engines we attempt to drive head-less against the SUT over uTP:
#   * rtorrent — a libtorrent-based, fully head-less CLI client. libtorrent is
#     the reference uTP implementation BEP29 is written against, so an rtorrent
#     <-> ntx uTP download is the highest-value interop cell. rtorrent can be
#     told to use uTP (network.use_utp) via its session config.
#   * qbittorrent-nox — a libtorrent-based GUI binary. It is included because
#     the brief names qBittorrent; if it never opens a listening socket under
#     Xvfb (the usual outcome for a GUI torrent client head-less) the matrix
#     records the observed reason and SKIPs, never a fabricated PASS.
#
# A single v1 fixture is baked in so the image is self-contained (the sshfs host
# mount cannot be bind-mounted by the docker daemon).
FROM debian:bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        rtorrent \
        qbittorrent-nox xvfb xauth dbus \
        ca-certificates python3 coreutils iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY engine-seed.sh /usr/local/bin/engine-seed.sh
RUN chmod +x /usr/local/bin/engine-seed.sh

# a plain v1 torrent fixture (regenerated by the harness before the build if
# absent; see build_engine_image / the gen step in interop_utp.sh)
COPY fixture /interop/fixture

WORKDIR /interop
