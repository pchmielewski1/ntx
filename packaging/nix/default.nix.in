{ lib
, stdenv
, src
, version ? "@VERSION@"
}:

stdenv.mkDerivation {
  pname = "ntx";
  inherit version src;

  makeFlags = [ "ntx" "NTX_VERSION=${version}" ];

  installPhase = ''
    runHook preInstall
    install -Dm755 ntx $out/bin/ntx
    install -Dm644 README.md CHANGELOG.md -t $out/share/doc/ntx
    install -Dm644 LICENSE -t $out/share/licenses/ntx
    runHook postInstall
  '';

  meta = with lib; {
    description = "Small BitTorrent client in one C binary (libc + libm only)";
    homepage = "https://github.com/pchmielewski1/ntx";
    license = licenses.mit;
    platforms = platforms.linux;
    mainProgram = "ntx";
  };
}
