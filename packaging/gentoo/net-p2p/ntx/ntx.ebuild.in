EAPI=8

DESCRIPTION="Small BitTorrent client in one C binary (libc + libm only)"
HOMEPAGE="https://github.com/pchmielewski1/ntx"
SRC_URI="https://github.com/pchmielewski1/ntx/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE=""

DEPEND=""
RDEPEND=""
BDEPEND="sys-devel/gcc"

src_compile() {
	emake ntx NTX_VERSION="${PV}"
}

src_install() {
	dobin ntx
	dodoc README.md CHANGELOG.md
}
